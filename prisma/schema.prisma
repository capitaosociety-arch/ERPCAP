generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String?   @unique
  phone         String?
  password      String
  role          String    @default("WAITER") // ADMIN, MANAGER, CASHIER, WAITER
  isActive      Boolean   @default(true)
  
  permDashboard   Boolean @default(false)
  permPDV         Boolean @default(true)
  permComandas    Boolean @default(true)
  permProducts    Boolean @default(false)
  permStock       Boolean @default(false)
  permCustomers   Boolean @default(false)
  permFinance     Boolean @default(false)
  permUsers       Boolean @default(false)
  permDepot       Boolean @default(false)
  permInteligencia Boolean @default(false)
  permCopilot     Boolean @default(false)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  auditLogs     AuditLog[]
  copilotLogs   CopilotLog[]
  cashRegisters CashRegister[]
  orders        Order[]       @relation("CreatedOrders")
  payments      Payment[]
  requestedTransfers  TransferRequest[] @relation("RequestedTransfers")
  authorizedTransfers TransferRequest[] @relation("AuthorizedTransfers")
  recommendations RecommendationHistory[] @relation("AdminApprovedRecommendations")
  priceChanges  PriceChange[] @relation("AuthorizedPriceChanges")

  @@index([name])
  @@index([role])
  @@index([isActive])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  cpf       String?
  birthDate DateTime?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  services     Service[]      @relation("CustomerServices")
  subscription Subscription?
  rentals      Rental[]
  score        CustomerScore?
  scoreHistory CustomerScoreHistory[]

  @@index([name])
  @@index([cpf])
  @@index([phone])
}

model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  status    String   @default("LIVRE") // LIVRE, OCUPADA, RESERVADA, FECHANDO
  capacity  Int      @default(4)
  
  orders    Order[]

  @@index([status])
}

model Order {
  id          String   @id @default(cuid())
  tableId     String?
  customerId  String?
  userId      String   
  status      String   @default("OPEN") // OPEN, CLOSED, CANCELED
  total       Float    @default(0.0)
  discount    Float    @default(0.0)
  notes       String?
  openedAt    DateTime @default(now())
  closedAt    DateTime?

  table       Table?    @relation(fields: [tableId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])
  user        User      @relation("CreatedOrders", fields: [userId], references: [id])
  
  items       OrderItem[]
  payments    Payment[]

  @@index([status])
  @@index([openedAt])
  @@index([tableId])
  @@index([customerId])
  @@index([userId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  serviceId   String?
  quantity    Float    @default(1)
  unitPrice   Float
  subtotal    Float
  notes       String?
  status      String   @default("ACTIVE") // ACTIVE, CANCELED

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  service     Service? @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  categoryId  String
  description String?
  price       Float
  cost        Float    @default(0.0)
  iconUrl     String?
  unit        String   @default("UN")
  isActive    Boolean  @default(true)
  allowAddons Boolean  @default(false)
  allowFractional Boolean @default(false)
  
  category    ProductCategory @relation(fields: [categoryId], references: [id])
  
  orderItems  OrderItem[]
  stock       Stock?
  stockMovements StockMovement[]
  priceHistories PriceHistory[]
  depotStock       DepotStock?
  depotMovements   DepotMovement[]
  transferRequests TransferRequest[]
  stockCounts      StockCount[]

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
}

model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  products    Product[]

  @@index([name])
}

model Service {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  price       Float
  isActive    Boolean  @default(true)
  durationMin Int?
  customerId  String?

  customer    Customer? @relation("CustomerServices", fields: [customerId], references: [id])
  orderItems  OrderItem[]

  @@index([name])
  @@index([category])
}

model Stock {
  id          String   @id @default(cuid())
  productId   String   @unique
  quantity    Float    @default(0)
  minQuantity Float    @default(5)
  unit        String   @default("UN")
  
  product     Product  @relation(fields: [productId], references: [id])
}

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  type        String   // IN, OUT_SALE, OUT_MANUAL, LOSS
  quantity    Float
  unitCost    Float?   // Custo unitário no momento da saída (snapshot p/ DRE)
  notes       String?
  document    String?  // Number of NF or receipt
  imageUrl    String?  // Link to the uploaded invoice image
  date        DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([date])
}

model CashRegister {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("OPEN") // OPEN, CLOSED
  openingBal  Float    @default(0.0)
  closingBal  Float?
  notes       String?
  openedAt    DateTime @default(now())
  closedAt    DateTime?
  
  user        User     @relation(fields: [userId], references: [id])
  payments    Payment[]
  deposits    CashDeposit[]

  @@index([userId])
  @@index([status])
  @@index([openedAt])
}

model CashDeposit {
  id             String   @id @default(cuid())
  cashRegisterId String
  amount         Float
  date           DateTime @default(now())
  notes          String?
  status         String   @default("PENDING") // PENDING, CONFERIDO

  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])

  @@index([cashRegisterId])
  @@index([date])
}

model Payment {
  id             String   @id @default(cuid())
  orderId        String
  cashRegisterId String
  userId         String
  method         String   // CASH, PIX, DEBIT, CREDIT
  amount         Float
  date           DateTime @default(now())

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
  user           User     @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([cashRegisterId])
  @@index([date])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String
  details     String?
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

model CopilotLog {
  id          String    @id @default(cuid())
  userId      String
  pergunta    String
  resposta    String?
  ferramentas Json?     // lista de { name, periodo, origem, nota } usadas
  status      String    @default("PROCESSING") // PROCESSING | DONE | ERROR
  erro        String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model PriceHistory {
  id          String   @id @default(cuid())
  productId   String
  price       Float    // Preço de venda
  cost        Float?   // Preço de custo
  invoice     String?  // Número da NF
  date        DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([date])
}

model Subscription {
  id          String   @id @default(cuid())
  customerId  String   @unique
  planName    String   
  amount      Float
  dueDate     Int      // day of month (1-31)
  nextDueDate DateTime
  isActive    Boolean  @default(true)

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments    SubscriptionPayment[]

  @@index([isActive])
  @@index([dueDate])
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  amount         Float
  paymentDate    DateTime     @default(now())
  referenceMonth DateTime     
  
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([paymentDate])
}

model Rental {
  id          String   @id @default(cuid())
  customerId  String
  resource    String   // Quadra 1, etc
  startTime   DateTime
  endTime     DateTime
  totalAmount Float
  status      String   @default("PENDING") // PENDING, PAID, CANCELED, NO_SHOW
  cancelledAt DateTime?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([status])
  @@index([startTime])
}

model OccupationSettings {
  id             String   @id @default("default")
  capacidadeFut5 Int      @default(2)
  capacidadeFut7 Int      @default(1)
  abertura       Int      @default(6) // hora de abertura dos campos
  fechamento     Int      @default(24) // hora de fechamento (exclusiva)
  // Limiares configuráveis da classificação automática de horários (percentuais)
  ociosoLimite       Int @default(25)  // ocupação abaixo => MUITO OCIOSO
  saudavelLimite     Int @default(50)  // ocupação a partir daqui => SAUDÁVEL
  altaDemandaLimite  Int @default(80)  // ocupação a partir daqui => ALTA DEMANDA
  saturadoLimite     Int @default(95)  // ocupação a partir daqui => SATURADO
  diasAvaliacaoElasticidade Int @default(30) // período mínimo (dias) p/ avaliar alteração de preço
  updatedAt      DateTime @updatedAt
}

model PricingBand {
  id        String   @id @default(cuid())
  campo     String   // 'fut5' | 'fut7'
  startHour Int
  endHour   Int
  minPrice  Float
  maxPrice  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campo, startHour, endHour])
}

model RecommendationHistory {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  campo          String   // 'fut5' | 'fut7' | 'ambos'
  diaSemana      String?
  horaInicio     Int?
  horaFim        Int?
  categoria      String   // AUMENTAR_PRECO | REDUZIR_PRECO | PROMOCAO | REALINHAR | MANTER
  precoAtual     Float
  precoSugerido  Float
  nivelConfianca Float
  motivo         String
  periodoRef     String
  decisao        String   @default("PENDENTE") // PENDENTE | ACEITA | REJEITADA
  decisaoNota    String?
  adminId        String?
  admin          User?    @relation("AdminApprovedRecommendations", fields: [adminId], references: [id])
  precoAplicado  Float?   // preço efetivamente aplicado após aprovação do admin
  periodoTesteDias Int?   // período de teste definido pelo admin
  resultado      String?  // EM_AVALIACAO | MELHOROU | AUMENTOU_OCUPACAO | REDUZIU_MARGEM | SEM_EFEITO
  resultadoNota  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([decisao])
  @@index([campo])
  @@index([adminId])
}

// Histórico de alterações de preço dos campos para análise de elasticidade.
// O sistema NUNCA altera preço sozinho: todo registro aqui é criado por uma
// ação explícita de um administrador (após aprovação de recomendação ou manual).
model PriceChange {
  id            String   @id @default(cuid())
  campo         String   // 'fut5' | 'fut7'
  startHour     Int
  endHour       Int
  precoAnterior Float
  precoNovo     Float
  autorId       String
  autor         User     @relation("AuthorizedPriceChanges", fields: [autorId], references: [id])
  // Snapshot "antes" calculado no momento da alteração (rastreabilidade)
  ocupacaoAntes   Float?
  receitaAntes    Float?
  consumoBarAntes Float?
  // "Depois" é calculado após o período mínimo (diasAvaliacaoElasticidade)
  ocupacaoDepois   Float?
  receitaDepois    Float?
  consumoBarDepois Float?
  appliedAt        DateTime @default(now())
  status           String   @default("EM_AVALIACAO") // EM_AVALIACAO | AVALIADO
  resultado        String?  // MELHOROU | AUMENTOU_OCUPACAO | REDUZIU_MARGEM | SEM_EFEITO
  nota             String?

  @@index([campo, startHour, endHour])
  @@index([appliedAt])
  @@index([autorId])
}

model FinancialEntry {
  id               String   @id @default(cuid())
  description      String
  type             String   // 'PAYABLE' (Pagar) ou 'RECEIVABLE' (Receber)
  amount           Float
  dueDate          DateTime
  paymentDate      DateTime?
  status           String   @default("PENDING") // 'PENDING', 'PAID', 'CANCELED'
  category         String   // Ex: Aluguel, Fornecedor, Salário, Internet, Diversos
  method           String?  // PIX, CASH, CARD, BOLETO, TRANSFER, etc
  reference        String?  // Mês/Ano de referência (MM/YYYY)
  installmentGroup String?  // ID para agrupar parcelas
  installmentNum   Int?     // Número da parcela (1, 2, 3...)
  installmentTotal Int?     // Total de parcelas
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([paymentDate])
  @@index([category])
}

model DepotStock {
  id          String   @id @default(cuid())
  productId   String   @unique
  quantity    Float    @default(0)
  minQuantity Float    @default(5)
  unit        String   @default("UN")
  
  product     Product  @relation(fields: [productId], references: [id])
}

model DepotMovement {
  id           String    @id @default(cuid())
  productId    String
  type         String    // IN, OUT_TRANSFER, LOSS, ADJUSTMENT
  quantity     Float
  notes        String?
  document     String?   // Number of NF ou Recibo
  imageUrl     String?   // Link para imagem da nota
  issueDate    DateTime? // Data de emissão da NF
  receivedDate DateTime? // Data de recebimento dos produtos
  date         DateTime  @default(now())

  product      Product   @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([date])
}

model TransferRequest {
  id              String   @id @default(cuid())
  productId       String
  quantity        Float
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  userId          String   // Solicitante
  authorizedById  String?  // Autorizador
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id])
  user            User     @relation("RequestedTransfers", fields: [userId], references: [id])
  authorizedBy    User?    @relation("AuthorizedTransfers", fields: [authorizedById], references: [id])

  @@index([productId])
  @@index([status])
  @@index([createdAt])
}

// Contagem diária de estoque (apenas informativa - NÃO altera o estoque real)
model StockCount {
  id        String   @id @default(cuid())
  productId String
  location  String   @default("DEPOT") // DEPOT (Matriz) ou BALCAO
  date      String   // YYYY-MM-DD (dia da contagem)
  quantity  Float    // Quantidade contada fisicamente
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, date, location])
  @@index([date])
  @@index([productId])
  @@index([location])
}

// ---------------------------------------------------------------------------
// Score de Clientes (Capitão Society)
// ---------------------------------------------------------------------------

// Score atual de cada cliente (cache/snapshot; o valor real é recalculado
// sempre na carga da tela pelo motor em lib/score.ts).
model CustomerScore {
  id            String   @id @default(cuid())
  customerId    String   @unique
  score         Int
  classificacao String
  componentes   Json     // { fator: { peso, pontos, normalizado, motivo } }
  recomendacao  String
  updatedAt     DateTime @updatedAt

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([score])
}

// Histórico de snapshots do score (para evolução ao longo do tempo).
model CustomerScoreHistory {
  id            String   @id @default(cuid())
  customerId    String
  score         Int
  classificacao String
  componentes   Json
  snapshotAt    DateTime @default(now())

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([snapshotAt])
}

// Configuração de pesos e limiares do score (linha única, id = 1).
model ScoreConfig {
  id        Int      @id @default(1)
  pesos     Json     // { frequencia, gastoAluguel, consumoBar, pontualidade, cancelamentos, faltas, recencia, recorrencia, inadimplencia }
  limiares  Json     // { reservasRef, aluguelRef, barRef, prazoCancelamentoHoras, diasInatividade, mesesAnalise, graceDiasMensalidade, capInadimplente }
  updatedAt DateTime @updatedAt
}

